}
QPushButton#btnLogin {
    background-color: #0077be;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    font-weight: bold;
    min-height: 38px;
}
QPushButton#btnLogin:hover { background-color: #005fa0; }
QPushButton#btnLogin:pressed { background-color: #004880; }
QPushButton#btnExit {
