   <string notr="true">
QDialog {
    background-color: #f0f6fc;
    font-family: 'Segoe UI', Arial, sans-serif;
}
QLabel#titleLabel {
    color: #004a7c;
    font-size: 16px;
    font-weight: bold;
    padding: 4px 0 2px 0;
}
QFrame#headerLine {
    background-color: #0077be;
    max-height: 2px;
    border: none;
}
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #c0d8ec;
    border-radius: 8px;
    margin-top: 10px;
    padding: 6px 10px 10px 10px;
    font-weight: bold;
    font-size: 12px;
    color: #004a7c;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #0077be;
    background-color: #f0f6fc;
}
QLabel {
    color: #2a5a8a;
    font-size: 12px;
    font-weight: 600;
}
QLineEdit, QComboBox, QDateEdit, QTimeEdit {
    background-color: #ffffff;
    color: #1a3a5c;
    border: 1px solid #a0c4e0;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
    min-height: 28px;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus {
    border: 1.5px solid #0077be;
    background-color: #fafdff;
}
QPushButton#btnSave {
    background-color: #0077be;
    color: #ffffff;
    border: none;
    border-radius: 7px;
    padding: 8px 28px;
    font-size: 13px;
    font-weight: bold;
    min-height: 34px;
}
QPushButton#btnSave:hover { background-color: #005fa0; }
QPushButton#btnSave:pressed { background-color: #004880; }
QPushButton#btnCancel {
    background-color: #e8f0f8;
    color: #2a5a8a;
    border: 1px solid #a0c4e0;
    border-radius: 7px;
    padding: 8px 28px;
    font-size: 13px;
    min-height: 34px;
}
QPushButton#btnCancel:hover { background-color: #d4e6f5; }
