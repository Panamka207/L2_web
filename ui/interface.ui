/* ===== GLOBAL ===== */
QMainWindow, QWidget {
    background-color: #0f1923;
    color: #d0dce8;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
}

/* ===== SIDE PANEL ===== */
QFrame#sidePanel {
    background-color: #141f2d;
    border-right: 1px solid #1e3450;
    min-width: 190px;
    max-width: 190px;
}

QLabel#appTitle {
    color: #4fc3f7;
    font-size: 17px;
    font-weight: bold;
    padding: 18px 12px 2px 12px;
    letter-spacing: 1px;
}

QLabel#appSubtitle {
    color: #5a7a96;
    font-size: 11px;
    padding: 0 12px 14px 12px;
    letter-spacing: 0.5px;
}

QLabel#userLabel {
    color: #5a7a96;
    font-size: 11px;
    padding: 8px 12px 16px 16px;
}

/* ===== MENU BUTTONS ===== */
QPushButton[checkable="true"] {
    background-color: transparent;
    color: #8faabf;
    border: none;
    border-radius: 0;
    text-align: left;
    padding: 11px 12px 11px 20px;
    font-size: 13px;
    font-weight: normal;
}

QPushButton[checkable="true"]:hover {
    background-color: #1a2d42;
    color: #d0dce8;
}

QPushButton[checkable="true"]:checked {
    background-color: #0d2137;
    color: #4fc3f7;
    border-left: 3px solid #4fc3f7;
    font-weight: bold;
}

/* ===== TOP BAR ===== */
QFrame#topBar {
    background-color: #141f2d;
    border-bottom: 1px solid #1e3450;
    min-height: 52px;
    max-height: 52px;
}

QLabel#pageTitle {
    color: #e0eaf3;
    font-size: 18px;
    font-weight: bold;
    padding: 0 0 0 6px;
}

/* ===== ACTION BAR ===== */
QFrame#actionBar {
    background-color: #0f1923;
    border-bottom: 1px solid #1a2d42;
    min-height: 44px;
    max-height: 44px;
}

/* ===== FILTER BAR ===== */
QFrame#filterBar {
    background-color: #111b27;
    border-bottom: 1px solid #1a2d42;
}

/* ===== INPUTS ===== */
QLineEdit, QComboBox, QDateEdit {
    background-color: #1a2d42;
    color: #d0dce8;
    border: 1px solid #1e3a55;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
    min-height: 26px;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid #4fc3f7;
}

QLineEdit::placeholder {
    color: #4a6a82;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #1a2d42;
    color: #d0dce8;
    border: 1px solid #1e3a55;
    selection-background-color: #0d2137;
    selection-color: #4fc3f7;
}

/* ===== BUTTONS ===== */
QPushButton:not([checkable="true"]) {
    background-color: #1a3a5c;
    color: #b8d4ec;
    border: 1px solid #1e4a72;
    border-radius: 5px;
    padding: 6px 14px;
    font-size: 12px;
    min-height: 26px;
}

QPushButton:not([checkable="true"]):hover {
    background-color: #1e4a72;
    color: #e0f0ff;
    border-color: #4fc3f7;
}

QPushButton:not([checkable="true"]):pressed {
    background-color: #0d2137;
}

QPushButton#btnAdd {
    background-color: #0d4a2d;
    color: #6ddfa0;
    border: 1px solid #1a6b44;
}

QPushButton#btnAdd:hover {
    background-color: #1a6b44;
    color: #a0f0c0;
    border-color: #4dbb80;
}

QPushButton#btnDelete {
    background-color: #4a0d1a;
    color: #f08080;
    border: 1px solid #7a1a2a;
}

QPushButton#btnDelete:hover {
    background-color: #7a1a2a;
    color: #ffaaaa;
    border-color: #cc4444;
}

QPushButton#btnSearch {
    background-color: #0d3a5c;
    color: #80c8f0;
    border: 1px solid #1a5580;
}

QPushButton#btnSearch:hover {
    background-color: #1a5580;
    border-color: #4fc3f7;
    color: #d0eeff;
}

QPushButton#btnReset {
    background-color: #2a1a0d;
    color: #d4a060;
    border: 1px solid #5a3a1a;
}

QPushButton#btnReset:hover {
    background-color: #5a3a1a;
    color: #f0c080;
    border-color: #c08040;
}

/* ===== TABLES ===== */
QTableWidget {
    background-color: #0f1923;
    color: #c8d8e8;
    gridline-color: #1a2d42;
    border: none;
    font-size: 12px;
    selection-background-color: #0d2a40;
    selection-color: #80d0f8;
    alternate-background-color: #111e2c;
}

QTableWidget::item {
    padding: 5px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #0d2a40;
    color: #80d0f8;
}

QHeaderView::section {
    background-color: #1a2d42;
    color: #7ab8d8;
    border: none;
    border-right: 1px solid #0f1923;
    border-bottom: 2px solid #4fc3f7;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #203a55;
    color: #a0d8f8;
    cursor: pointer;
}

QScrollBar:vertical {
    background: #0f1923;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #1e3a55;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #2a5a80;
}

QScrollBar:horizontal {
    background: #0f1923;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #1e3a55;
    border-radius: 4px;
    min-width: 30px;
}

/* ===== GROUP BOX ===== */
QGroupBox {
    background-color: #111b27;
    border: 1px solid #1e3450;
    border-radius: 7px;
    margin-top: 8px;
    padding-top: 6px;
    color: #7ab8d8;
    font-weight: bold;
    font-size: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #4fc3f7;
    background-color: #111b27;
}

/* ===== LABELS in bars ===== */
QLabel#labelStatus, QLabel#labelFrom, QLabel#labelTo,
QLabel#labelReportType, QLabel#labelFilterStatus,
QLabel#labelFilterClass, QLabel#labelFilterCountry {
    color: #6a9ab8;
    font-size: 12px;
}
