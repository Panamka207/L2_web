<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1200</width>
    <height>750</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Авиакомпания</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ===== GLOBAL ===== */
QMainWindow, QWidget {
    background-color: #f0f8ff;  /* светло-голубой фон */
    color: #1a3a5c;  /* темно-синий текст */
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
}

/* ===== SIDE PANEL ===== */
QFrame#sidePanel {
    background-color: #e6f0fa;  /* очень светлый голубой */
    border-right: 1px solid #b8d4e8;
    min-width: 190px;
    max-width: 190px;
}

QLabel#appTitle {
    color: #0077be;  /* насыщенный голубой */
    font-size: 17px;
    font-weight: bold;
    padding: 18px 12px 2px 12px;
    letter-spacing: 1px;
    background-color: transparent;  /* прозрачный фон */
}

QLabel#appSubtitle {
    color: #5a8ab8;  /* спокойный синий */
    font-size: 11px;
    padding: 0 12px 14px 12px;
    letter-spacing: 0.5px;
    background-color: transparent;  /* прозрачный фон */
}

QLabel#userLabel {
    color: #6a8aaa;  /* мягкий синий */
    font-size: 11px;
    padding: 8px 12px 16px 16px;
    background-color: transparent;  /* прозрачный фон */
}

/* ===== MENU BUTTONS ===== */
QPushButton[checkable=&quot;true&quot;] {
    background-color: transparent;
    color: #2a5a8a;  /* синий для текста */
    border: none;
    border-radius: 0;
    text-align: left;
    padding: 11px 12px 11px 20px;
    font-size: 13px;
    font-weight: normal;
}

QPushButton[checkable=&quot;true&quot;]:hover {
    background-color: #d4e6f5;  /* светлый голубой при наведении */
    color: #005a9e;
}

QPushButton[checkable=&quot;true&quot;]:checked {
    background-color: #cce0f0;  /* выделенный пункт меню */
    color: #0066b3;
    border-left: 3px solid #0077be;
    font-weight: bold;
}

/* ===== TOP BAR ===== */
QFrame#topBar {
    background-color: #e6f0fa;  /* тот же фон, что и sidePanel */
    border-bottom: 1px solid #c0d8ec;
    min-height: 52px;
    max-height: 52px;
}

QLabel#pageTitle {
    color: #004a7c;  /* темно-синий */
    font-size: 18px;
    font-weight: bold;
    padding: 0 0 0 6px;
    background-color: transparent;  /* прозрачный фон */
}

/* ===== ACTION BAR ===== */
QFrame#actionBar {
    background-color: #eef4fa;  /* очень светлый голубой */
    border-bottom: 1px solid #c8ddec;
    min-height: 44px;
    max-height: 44px;
}

/* ===== FILTER BAR ===== */
QFrame#filterBar {
    background-color: #e8f0f8;  /* светлый голубой */
    border-bottom: 1px solid #c8ddec;
}

/* ===== INPUTS ===== */
QLineEdit, QComboBox, QDateEdit {
    background-color: #ffffff;  /* белый фон */
    color: #1a3a5c;  /* темно-синий текст */
    border: 1px solid #a0c4e0;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
    min-height: 26px;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid #0077be;
}

QLineEdit::placeholder {
    color: #90a8c0;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a3a5c;
    border: 1px solid #a0c4e0;
    selection-background-color: #d4e6f5;
    selection-color: #005a9e;
}

/* ===== BUTTONS ===== */
QPushButton:not([checkable=&quot;true&quot;]) {
    background-color: #d4e6f5;  /* светлый голубой */
    color: #004a7c;  /* темно-синий */
    border: 1px solid #90b8d8;
    border-radius: 8px;  /* было 5px, увеличил для современного вида */
    padding: 6px 14px;
    font-size: 12px;
    min-height: 26px;
}

QPushButton:not([checkable=&quot;true&quot;]):hover {
    background-color: #b8d8f0;  /* более насыщенный голубой */
    color: #003e6b;
    border-color: #0077be;
}

QPushButton:not([checkable=&quot;true&quot;]):pressed {
    background-color: #a0c8e8;
}

QPushButton#btnAdd {
    background-color: #c8e8dc;  /* мягкий мятно-голубой */
    color: #005a7a;
    border: 1px solid #90c8b0;
    border-radius: 8px;  /* скругление */
}

QPushButton#btnAdd:hover {
    background-color: #a8d8c8;
    color: #003e5a;
    border-color: #40b090;
}

QPushButton#btnDelete {
    background-color: #f0d8dc;  /* мягкий розовато-голубой оттенок */
    color: #9a5060;
    border: 1px solid #d0b0b8;
    border-radius: 8px;  /* скругление */
}

QPushButton#btnDelete:hover {
    background-color: #e8c0c8;
    color: #c04050;
    border-color: #e07080;
}

QPushButton#btnSearch {
    background-color: #cce0f5;  /* нежно-голубой */
    color: #005a9e;
    border: 1px solid #90b4dc;
    border-radius: 8px;  /* скругление */
}

QPushButton#btnSearch:hover {
    background-color: #b0d0f0;
    border-color: #0077be;
    color: #003e7c;
}

QPushButton#btnReset {
    background-color: #e8e0d0;  /* очень светлый бежево-голубой */
    color: #8a7050;
    border: 1px solid #c8bc9c;
    border-radius: 8px;  /* скругление */
}

QPushButton#btnReset:hover {
    background-color: #d8ccb0;
    color: #a07848;
    border-color: #c09850;
}

/* ===== TABLES ===== */
QTableWidget {
    background-color: #ffffff;  /* белый фон таблицы */
    color: #1a3a5c;  /* темно-синий текст */
    gridline-color: #d4e4f0;
    border: none;
    font-size: 12px;
    selection-background-color: #e0ecf8;
    selection-color: #004a7c;
    alternate-background-color: #f5faff;  /* очень светлый голубой для чередования */
}

QTableWidget::item {
    padding: 5px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #d4e6f5;
    color: #003e6b;
}

QHeaderView::section {
    background-color: #e0ecf8;  /* светлый голубой для заголовков */
    color: #004a7c;
    border: none;
    border-right: 1px solid #f0f8ff;
    border-bottom: 2px solid #0077be;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #c8ddf0;
    color: #003a6a;
    cursor: pointer;
}

QScrollBar:vertical {
    background: #e0eaf2;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #b0c8e0;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #80a8c8;
}

QScrollBar:horizontal {
    background: #e0eaf2;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #b0c8e0;
    border-radius: 4px;
    min-width: 30px;
}

/* ===== GROUP BOX ===== */
QGroupBox {
    background-color: #f5faff;  /* очень светлый голубой */
    border: 1px solid #c0d8ec;
    border-radius: 7px;
    margin-top: 8px;
    padding-top: 6px;
    color: #005a9e;
    font-weight: bold;
    font-size: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #0077be;
    background-color: #f5faff;
}

/* ===== LABELS in bars ===== */
QLabel#labelStatus, QLabel#labelFrom, QLabel#labelTo,
QLabel#labelReportType, QLabel#labelFilterStatus,
QLabel#labelFilterClass, QLabel#labelFilterCountry {
    color: #3a6a9a;  /* приятный синий */
    font-size: 12px;
    background-color: transparent;  /* прозрачный фон */
}</string>
