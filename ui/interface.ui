/* ===== GLOBAL ===== */
QMainWindow, QWidget {
    background-color: #eef5fb;
    color: #2b4257;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
}

/* ===== SIDE PANEL ===== */
QFrame#sidePanel {
    background-color: #d9e9f5;
    border-right: 1px solid #b8d1e5;
    min-width: 190px;
    max-width: 190px;
}

QLabel#appTitle {
    color: #3b82b6;
    font-size: 17px;
    font-weight: bold;
    padding: 18px 12px 2px 12px;
    letter-spacing: 1px;
}

QLabel#appSubtitle {
    color: #6b8aa3;
    font-size: 11px;
    padding: 0 12px 14px 12px;
    letter-spacing: 0.5px;
}

QLabel#userLabel {
    color: #6b8aa3;
    font-size: 11px;
    padding: 8px 12px 16px 16px;
}

/* ===== MENU BUTTONS ===== */
QPushButton[checkable=&quot;true&quot;] {
    background-color: transparent;
    color: #4d6980;
    border: none;
    border-radius: 0;
    text-align: left;
    padding: 11px 12px 11px 20px;
    font-size: 13px;
}

QPushButton[checkable=&quot;true&quot;]:hover {
    background-color: #c7dfee;
    color: #24445d;
}

QPushButton[checkable=&quot;true&quot;]:checked {
    background-color: #b7d4e8;
    color: #2f6f9f;
    border-left: 3px solid #5ba8d6;
    font-weight: bold;
}

/* ===== TOP BAR ===== */
QFrame#topBar {
    background-color: #d9e9f5;
    border-bottom: 1px solid #b8d1e5;
    min-height: 52px;
    max-height: 52px;
}

QLabel#pageTitle {
    color: #2d4d66;
    font-size: 18px;
    font-weight: bold;
    padding: 0 0 0 6px;
}

/* ===== ACTION BAR ===== */
QFrame#actionBar {
    background-color: #e6f1f8;
    border-bottom: 1px solid #c7dfee;
    min-height: 44px;
    max-height: 44px;
}

/* ===== FILTER BAR ===== */
QFrame#filterBar {
    background-color: #edf5fb;
    border-bottom: 1px solid #c7dfee;
}

/* ===== INPUTS ===== */
QLineEdit, QComboBox, QDateEdit {
    background-color: #ffffff;
    color: #2b4257;
    border: 1px solid #b7d0e2;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    min-height: 26px;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid #6cb7e5;
    background-color: #fafdff;
}

QLineEdit::placeholder {
    color: #7f9db3;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2b4257;
    border: 1px solid #b7d0e2;
    selection-background-color: #d6eaf7;
    selection-color: #2f6f9f;
}

/* ===== BUTTONS ===== */
QPushButton:not([checkable=&quot;true&quot;]) {
    background-color: #d7ebf7;
    color: #2c5d80;
    border: 1px solid #a7cde3;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    min-height: 26px;
}

QPushButton:not([checkable=&quot;true&quot;]):hover {
    background-color: #c3e1f3;
    color: #20445f;
    border-color: #6cb7e5;
}

QPushButton:not([checkable=&quot;true&quot;]):pressed {
    background-color: #b1d5eb;
}

/* ===== ADD BUTTON ===== */
QPushButton#btnAdd {
    background-color: #d9f0ea;
    color: #2d7a66;
    border: 1px solid #9fd3c5;
}

QPushButton#btnAdd:hover {
    background-color: #c7e8df;
    border-color: #67b8a2;
}

/* ===== DELETE BUTTON ===== */
QPushButton#btnDelete {
    background-color: #f6e1e1;
    color: #b05656;
    border: 1px solid #e0b0b0;
}

QPushButton#btnDelete:hover {
    background-color: #f0d0d0;
    border-color: #d88888;
}

/* ===== SEARCH BUTTON ===== */
QPushButton#btnSearch {
    background-color: #d9ebf8;
    color: #3574a3;
    border: 1px solid #9fc8e5;
}

QPushButton#btnSearch:hover {
    background-color: #c8e1f5;
    border-color: #6cb7e5;
}

/* ===== RESET BUTTON ===== */
QPushButton#btnReset {
    background-color: #f4efe5;
    color: #8d6b42;
    border: 1px solid #dcc9aa;
}

QPushButton#btnReset:hover {
    background-color: #ece2d0;
    border-color: #c9aa73;
}

/* ===== TABLES ===== */
QTableWidget {
    background-color: #ffffff;
    color: #2b4257;
    gridline-color: #d7e7f2;
    border: none;
    font-size: 12px;
    selection-background-color: #d7ecf9;
    selection-color: #2f6f9f;
    alternate-background-color: #f6fbff;
}

QTableWidget::item {
    padding: 5px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #d7ecf9;
    color: #2f6f9f;
}

QHeaderView::section {
    background-color: #dcecf7;
    color: #3f6f92;
    border: none;
    border-right: 1px solid #c5dceb;
    border-bottom: 2px solid #7fb9de;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #cde3f2;
    color: #285170;
}

QScrollBar:vertical {
    background: #eef5fb;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #b7d0e2;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #8fb8d4;
}

QScrollBar:horizontal {
    background: #eef5fb;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #b7d0e2;
    border-radius: 4px;
    min-width: 30px;
}

/* ===== GROUP BOX ===== */
QGroupBox {
    background-color: #f7fbfe;
    border: 1px solid #c9dceb;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 6px;
    color: #4a6f8d;
    font-weight: bold;
    font-size: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #4d90bd;
    background-color: #f7fbfe;
}

/* ===== LABELS ===== */
QLabel#labelStatus,
QLabel#labelFrom,
QLabel#labelTo,
QLabel#labelReportType,
QLabel#labelFilterStatus,
QLabel#labelFilterClass,
QLabel#labelFilterCountry {
    color: #6d8aa0;
    font-size: 12px;
}
